
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  password  String
  phone     String?
  role      String
  updatedAt DateTime @updatedAt
  verified  Boolean  @default(false)
  orders    Order[]
  reviews   Review[]
  seller    Seller?
  deliveryProvider DeliveryProvider?
  deliveryDriver   DeliveryDriver?
  deliveryNotifications DeliveryNotification[]
}

model Seller {
  id             Int         @id @default(autoincrement())
  userId         Int         @unique
  shopName       String
  shopUrl        String?     @unique
  businessType   String
  image          String?
  bannerImage    String?
  status         String      @default("pending")
  commissionRate Float       @default(10.0)
  rating        Float   @default(5)
  reviewCount   Int     @default(0)
  views         Int     @default(0)
  featured      Boolean @default(false)
  location      String?
  memberSince   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listings       Listing[]
  orderItems     OrderItem[]
  user           User        @relation(fields: [userId], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  categoryId  Int
  title       String
  description String
  status      String   @default("active")

  seller      Seller   @relation(fields: [sellerId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  
  // Relations updated for variants
  variants    ProductVariant[]
  reviews     Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  listingId  Int
  sku        String?  @unique // Stock Keeping Unit (optional but recommended)
  price      Float    // Price can vary by variant (e.g., XXL costs more)
  stock      Int      @default(0) // Inventory tracked at the variant level
  status     String   @default("active")

  // The combination details stored as JSON (e.g., {"color": "Red", "size": "XL"})
  // This gives you the ultimate flexibility without needing complex EAV tables
  attributes Json     

  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  images     ProductImage[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  flashSaleItems FlashSaleItem[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Order {
  id              Int          @id @default(autoincrement())
  userId          Int
  orderNumber     String       @unique
  totalAmount     Float
  deliveryFee     Float        @default(0)
  paymentMethod   String
  paymentStatus   String       @default("pending")
  orderStatus     String       @default("placed")
  deliveryAddress String
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  delivery        Delivery?
  user            User         @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  transactions    Transaction?
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  variantId  Int      // Changed from listingId to variantId
  sellerId   Int
  quantity   Int
  unitPrice  Float
  subtotal   Float
  itemStatus String   @default("placed")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order      Order    @relation(fields: [orderId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id]) // Changed relation
  seller     Seller   @relation(fields: [sellerId], references: [id])
}

model Transaction {
  id                   Int       @id @default(autoincrement())
  orderId              Int       @unique
  transactionReference String    @unique
  paymentGateway       String
  amount               Float
  currency             String    @default("LKR")
  status               String    @default("pending")
  gatewayResponse      Json?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  order                Order     @relation(fields: [orderId], references: [id])
}

model DeliveryProvider {
  id            Int        @id @default(autoincrement())
  userId        Int?       @unique
  providerName  String
  contactPerson String
  email         String     @unique
  phone         String
  serviceArea   String
  baseFee       Float
  businessRegNo String?
  district      String?
  settings      Json?
  rejectionReason String?
  status        String     @default("pending")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User?      @relation(fields: [userId], references: [id])
  deliveries    Delivery[]
  drivers       DeliveryDriver[]
}

model DeliveryDriver {
  id              Int      @id @default(autoincrement())
  providerId      Int
  userId          Int?     @unique
  fullName        String
  email           String
  phone           String
  licenseNo       String?
  vehicleType     String   @default("Motorcycle")
  vehiclePlate    String?
  isAvailable     Boolean  @default(true)
  totalDeliveries Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        DeliveryProvider @relation(fields: [providerId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  deliveries      Delivery[]
}

model DeliveryNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Delivery {
  id                 Int               @id @default(autoincrement())
  orderId            Int               @unique
  deliveryProviderId Int?
  assignedDriverId   Int?
  trackingNumber     String?           @unique
  pickupAddress      String
  deliveryAddress    String
  deliveryStatus     String            @default("CONFIRMED")
  trackingPoints     Json?
  statusHistory      Json?
  failureReason      String?
  assignedAt         DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deliveryProvider   DeliveryProvider? @relation(fields: [deliveryProviderId], references: [id])
  assignedDriver     DeliveryDriver?   @relation(fields: [assignedDriverId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id])
}

model ProductImage {
  id         Int            @id @default(autoincrement())
  variantId  Int            // 👈 Points to the variant now
  url        String
  isMain     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

}

model SupportInquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model FlashSale {
  id        String          @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  status    String          @default("active") // active, inactive
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id             String         @id @default(uuid())
  flashSaleId    String
  flashSale      FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variantId      Int
  productVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  flashPrice     Float
  flashStock     Int            @default(0)
  soldCount      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}